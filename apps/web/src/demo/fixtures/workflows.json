{"workflows":[{"id":"wf-demo-faq-release","name":"FAQ answerer (release gated)","description":"Published behind a release gate: a new version reaches production only when its replay job against the golden set passes.","schemaVersion":"1.0.0","workflowVersion":1,"nodes":[{"id":"trigger","type":"manual_trigger","name":"Question","position":{"x":0,"y":120},"config":{"label":"Question"}},{"id":"agent","type":"agent_orchestrator","name":"FAQ agent","position":{"x":260,"y":120},"config":{"systemPromptTemplate":"[faq] Answer account questions from the help centre in one or two sentences.","userPromptTemplate":"{{user_prompt}}","maxIterations":2,"toolCallingEnabled":false}},{"id":"model","type":"llm_call","name":"Chat model","position":{"x":260,"y":320},"config":{"provider":{"providerId":"openai_compatible","model":"demo-model","baseUrl":"https://models.example.com/v1","temperature":0.2,"extra":{"maxRetries":0}},"promptKey":"prompt","systemPromptKey":"system_prompt"}},{"id":"output","type":"output","name":"Answer","position":{"x":520,"y":120},"config":{"responseTemplate":"FAQ: {{answer}}","outputKey":"result"}}],"edges":[{"id":"e1","source":"trigger","target":"agent"},{"id":"e2","source":"agent","target":"output"},{"id":"a1","source":"agent","target":"model","sourceHandle":"chat_model"}],"projectId":"default","tags":[],"createdAt":"2026-10-26T16:18:27.049Z","updatedAt":"2026-10-26T16:18:27.121Z"},{"id":"wf-demo-support-agent","name":"Support agent with MCP tools and memory","description":"An agent that answers customer questions with MCP tools (knowledge base lookup, calculator) and remembers the conversation.","schemaVersion":"1.0.0","workflowVersion":1,"nodes":[{"id":"trigger","type":"manual_trigger","name":"Ask a question","position":{"x":0,"y":120},"config":{"label":"Ask a question"}},{"id":"agent","type":"agent_orchestrator","name":"Support agent","position":{"x":280,"y":120},"config":{"systemPromptTemplate":"[support-agent] You answer customer questions. Use lookup_kb for product facts and calculator for prices. Keep answers short.","userPromptTemplate":"{{user_prompt}}","sessionIdTemplate":"demo-support","maxIterations":4,"toolCallingEnabled":true}},{"id":"model","type":"llm_call","name":"Chat model","position":{"x":140,"y":340},"config":{"provider":{"providerId":"openai_compatible","model":"demo-model","baseUrl":"https://models.example.com/v1","temperature":0.2,"extra":{"maxRetries":0}},"promptKey":"prompt","systemPromptKey":"system_prompt"}},{"id":"memory","type":"local_memory","name":"Session memory","position":{"x":300,"y":340},"config":{"namespace":"demo","sessionIdTemplate":"demo-support","maxMessages":20,"persistToolMessages":false}},{"id":"kb","type":"mcp_tool","name":"Knowledge base","position":{"x":460,"y":340},"config":{"serverId":"mock-mcp","toolName":"lookup_kb","argsTemplate":"{\"topic\":\"plans\"}","connection":{"transport":"mock","kbOverrides":{"plans":"Team plan: $12 per seat per month, billed yearly. Includes MCP tool access and session memory.","rag":"Retrieval-augmented generation grounds a prompt with passages retrieved from your own documents, so answers can cite them."}}}},{"id":"calc","type":"mcp_tool","name":"Calculator","position":{"x":620,"y":340},"config":{"serverId":"mock-mcp","toolName":"calculator","argsTemplate":"{\"expression\":\"1+1\"}","connection":{"transport":"mock"}}},{"id":"output","type":"output","name":"Answer","position":{"x":600,"y":120},"config":{"responseTemplate":"{{answer}}","outputKey":"result"}}],"edges":[{"id":"e1","source":"trigger","target":"agent"},{"id":"e2","source":"agent","target":"output"},{"id":"a1","source":"agent","target":"model","sourceHandle":"chat_model"},{"id":"a2","source":"agent","target":"memory","sourceHandle":"memory"},{"id":"a3","source":"agent","target":"kb","sourceHandle":"tool"},{"id":"a4","source":"agent","target":"calc","sourceHandle":"tool"}],"createdAt":"2026-10-26T16:18:23.626Z","updatedAt":"2026-10-26T16:18:27.046Z","tags":[],"projectId":"default"},{"id":"wf-demo-refund-approval","name":"Refund with human approval","description":"Drafts a refund reply and pauses for an approver, who can edit the reply before it is sent.","schemaVersion":"1.0.0","workflowVersion":1,"nodes":[{"id":"trigger","type":"manual_trigger","name":"Refund request","position":{"x":0,"y":140},"config":{"label":"Refund request"}},{"id":"draft","type":"set_node","name":"Draft reply","position":{"x":240,"y":140},"config":{"assignments":[{"key":"reply","valueTemplate":"Hi, we've refunded your order: {{user_prompt}}"}]}},{"id":"gate","type":"approval_gate","name":"Approve refund","position":{"x":480,"y":140},"config":{"message":"Send this refund reply? {{reply}}","approverRoles":["builder","admin"],"timeoutMinutes":1440,"timeoutOutcome":"fallback","editableFields":[{"key":"reply","label":"Reply","type":"text","valueTemplate":"{{reply}}","required":true,"maxLength":400}]}},{"id":"sent","type":"output","name":"Sent","position":{"x":740,"y":40},"config":{"responseTemplate":"sent: {{reply}}"}},{"id":"stopped","type":"output","name":"Rejected","position":{"x":740,"y":140},"config":{"responseTemplate":"rejected"}},{"id":"late","type":"output","name":"Timed out","position":{"x":740,"y":240},"config":{"responseTemplate":"timed out"}}],"edges":[{"id":"e1","source":"trigger","target":"draft"},{"id":"e2","source":"draft","target":"gate"},{"id":"e3","source":"gate","target":"sent","sourceHandle":"approved"},{"id":"e4","source":"gate","target":"stopped","sourceHandle":"rejected"},{"id":"e5","source":"gate","target":"late","sourceHandle":"timed_out"}],"projectId":"default","createdAt":"2026-10-26T16:18:23.634Z","updatedAt":"2026-10-26T16:18:23.634Z","tags":[]},{"id":"wf-demo-guarded-intake","name":"Guarded intake","description":"A prompt guard in front of the intake step: prompts with an email address are blocked before any model sees them.","schemaVersion":"1.0.0","workflowVersion":1,"nodes":[{"id":"trigger","type":"manual_trigger","name":"New request","position":{"x":0,"y":120},"config":{"label":"New request"}},{"id":"guard","type":"guard","name":"Prompt guard","position":{"x":260,"y":120},"config":{"profileId":"demo-strict-intake"}},{"id":"pass","type":"output","name":"Accepted","position":{"x":520,"y":40},"config":{"responseTemplate":"Accepted: {{results.guard.user_prompt}}"}},{"id":"blocked","type":"output","name":"Blocked","position":{"x":520,"y":220},"config":{"responseTemplate":"Blocked by the prompt guard."}}],"edges":[{"id":"e1","source":"trigger","target":"guard"},{"id":"e2","source":"guard","target":"pass","sourceHandle":"pass"},{"id":"e3","source":"guard","target":"blocked","sourceHandle":"blocked"}],"projectId":"default","createdAt":"2026-10-26T16:18:23.631Z","updatedAt":"2026-10-26T16:18:23.631Z","tags":[]},{"id":"wf-demo-research-swarm","name":"Research supervisor with two workers","description":"A supervisor delegates to a researcher (knowledge base tool) and an analyst (calculator tool), then writes the summary.","schemaVersion":"1.0.0","workflowVersion":1,"nodes":[{"id":"trigger","type":"manual_trigger","name":"Start","position":{"x":0,"y":140},"config":{"label":"Brief the team"}},{"id":"supervisor","type":"supervisor_node","name":"Supervisor","position":{"x":260,"y":140},"config":{"systemPromptTemplate":"[supervisor] Split the request, delegate to the researcher and the analyst, then summarise for the team.","userPromptTemplate":"{{user_prompt}}","sessionIdTemplate":"demo-swarm","maxIterations":6}},{"id":"supervisor_model","type":"llm_call","name":"Supervisor model","position":{"x":120,"y":360},"config":{"provider":{"providerId":"openai_compatible","model":"demo-model","baseUrl":"https://models.example.com/v1","temperature":0.2,"extra":{"maxRetries":0}},"promptKey":"prompt","systemPromptKey":"system_prompt"}},{"id":"researcher","type":"agent_orchestrator","name":"researcher","position":{"x":340,"y":360},"config":{"systemPromptTemplate":"[researcher] Answer factual questions with the lookup_kb tool.","userPromptTemplate":"{{user_prompt}}","maxIterations":3,"toolCallingEnabled":true}},{"id":"researcher_model","type":"llm_call","name":"Researcher model","position":{"x":260,"y":560},"config":{"provider":{"providerId":"openai_compatible","model":"demo-model","baseUrl":"https://models.example.com/v1","temperature":0.2,"extra":{"maxRetries":0}},"promptKey":"prompt","systemPromptKey":"system_prompt"}},{"id":"researcher_kb","type":"mcp_tool","name":"Knowledge base","position":{"x":420,"y":560},"config":{"serverId":"mock-mcp","toolName":"lookup_kb","argsTemplate":"{\"topic\":\"rag\"}","connection":{"transport":"mock","kbOverrides":{"plans":"Team plan: $12 per seat per month, billed yearly. Includes MCP tool access and session memory.","rag":"Retrieval-augmented generation grounds a prompt with passages retrieved from your own documents, so answers can cite them."}}}},{"id":"analyst","type":"agent_orchestrator","name":"analyst","position":{"x":620,"y":360},"config":{"systemPromptTemplate":"[analyst] Answer arithmetic with the calculator tool.","userPromptTemplate":"{{user_prompt}}","maxIterations":3,"toolCallingEnabled":true}},{"id":"analyst_model","type":"llm_call","name":"Analyst model","position":{"x":580,"y":560},"config":{"provider":{"providerId":"openai_compatible","model":"demo-model","baseUrl":"https://models.example.com/v1","temperature":0.2,"extra":{"maxRetries":0}},"promptKey":"prompt","systemPromptKey":"system_prompt"}},{"id":"analyst_calc","type":"mcp_tool","name":"Calculator","position":{"x":740,"y":560},"config":{"serverId":"mock-mcp","toolName":"calculator","argsTemplate":"{\"expression\":\"1+1\"}","connection":{"transport":"mock"}}},{"id":"output","type":"output","name":"Team summary","position":{"x":620,"y":140},"config":{"responseTemplate":"{{answer}}","outputKey":"result"}}],"edges":[{"id":"e1","source":"trigger","target":"supervisor"},{"id":"e2","source":"supervisor","target":"output"},{"id":"a1","source":"supervisor","target":"supervisor_model","sourceHandle":"chat_model"},{"id":"a2","source":"supervisor","target":"researcher","sourceHandle":"worker"},{"id":"a3","source":"supervisor","target":"analyst","sourceHandle":"worker"},{"id":"a4","source":"researcher","target":"researcher_model","sourceHandle":"chat_model"},{"id":"a5","source":"researcher","target":"researcher_kb","sourceHandle":"tool"},{"id":"a6","source":"analyst","target":"analyst_model","sourceHandle":"chat_model"},{"id":"a7","source":"analyst","target":"analyst_calc","sourceHandle":"tool"}],"projectId":"default","createdAt":"2026-10-26T16:18:23.629Z","updatedAt":"2026-10-26T16:18:23.629Z","tags":[]},{"id":"wf-workflow-as-mcp-tool","name":"Workflow as MCP Tool","description":"Compose-by-MCP pattern. The mcp_server_trigger node turns this whole workflow into an MCP tool exposed at GET /api/mcp-server/kb-helper/manifest and POST /api/mcp-server/kb-helper/invoke. Other agents (in L2M, in your IDE, in other MCP-compatible runtimes) can wire 'kb-helper' in as a callable tool. Inside, the workflow runs an Agent that consults the bundled mock-mcp lookup_kb tool to answer the question. Demonstrates: agent -> workflow -> agent composition without any HTTP plumbing.","schemaVersion":"1.0.0","workflowVersion":1,"nodes":[{"id":"mcp_trigger_1","type":"mcp_server_trigger","name":"Expose as MCP Tool","position":{"x":80,"y":200},"config":{"path":"kb-helper","toolName":"answer_from_kb","toolDescription":"Answer a question by looking it up in the L2M demo knowledge base.","inputSchema":{"type":"object","properties":{"question":{"type":"string","description":"Natural-language question to answer."}},"required":["question"]},"authMode":"public"}},{"id":"agent_1","type":"agent_orchestrator","name":"Agent","position":{"x":380,"y":200},"config":{"systemPromptTemplate":"Answer the user's question by calling the lookup_kb MCP tool. Reply with a concise factual sentence.","userPromptTemplate":"{{question}}","sessionIdTemplate":"kb-helper","maxIterations":4,"toolCallingEnabled":true}},{"id":"llm_1","type":"llm_call","name":"Chat Model (echo)","position":{"x":440,"y":380},"config":{"provider":{"providerId":"echo","model":"demo","prefix":"Echo: "},"promptKey":"prompt","systemPromptKey":"system_prompt"}},{"id":"tool_kb_1","type":"mcp_tool","name":"MCP: lookup_kb","position":{"x":660,"y":380},"config":{"serverId":"mock-mcp","toolName":"lookup_kb","argsTemplate":"{\"key\":\"mcp\"}","connection":{"transport":"mock"}}},{"id":"output_1","type":"output","name":"Output","position":{"x":720,"y":200},"config":{"responseTemplate":"{{answer}}","outputKey":"result"}}],"edges":[{"id":"edge_main_1","source":"mcp_trigger_1","target":"agent_1"},{"id":"edge_main_2","source":"agent_1","target":"output_1"},{"id":"edge_aux_chat","source":"agent_1","sourceHandle":"chat_model","target":"llm_1"},{"id":"edge_aux_tool","source":"agent_1","sourceHandle":"tool","target":"tool_kb_1"}],"projectId":"default","createdAt":"2026-10-26T16:18:23.603Z","updatedAt":"2026-10-26T16:18:23.603Z","tags":[]},{"id":"wf-rag-with-citations-flow","name":"RAG with Citations","description":"Text Input -> RAG Retrieve (KB) -> Prompt Template (with citation instructions) -> LLM -> Extract Citations -> Output. Demonstrates Phase 9.4 — every chunk retrieved by `rag_retrieve` carries stable provenance, the LLM is instructed to cite with [N] markers, and `extract_citations` resolves each marker back to the source chunk so the chat UI renders clickable footnotes. Replace `<your-kb-id>` with a real id from POST /api/knowledge-bases.","schemaVersion":"1.0.0","workflowVersion":1,"nodes":[{"id":"text_1","type":"text_input","name":"Question","position":{"x":70,"y":220},"config":{"text":"How do I reset my password?"}},{"id":"rag_1","type":"rag_retrieve","name":"Retrieve","position":{"x":360,"y":220},"config":{"queryTemplate":"{{user_prompt}}","topK":4,"embedderId":"openai-embedder","vectorStoreId":"knowledge-base","vectorStoreConfig":{"knowledgeBaseId":"<your-kb-id>"},"searchMode":"hybrid"}},{"id":"template_1","type":"prompt_template","name":"Grounded Prompt","position":{"x":670,"y":220},"config":{"template":"Answer the question using only the context below.\n\n{{citationInstructions}}\n\nContext:\n{{context}}\n\nQuestion:\n{{user_prompt}}","outputKey":"prompt"}},{"id":"llm_1","type":"llm_call","name":"LLM","position":{"x":980,"y":220},"config":{"provider":{"providerId":"openai","model":"gpt-4o-mini","temperature":0.1},"promptKey":"prompt","outputKey":"answer"}},{"id":"cite_1","type":"extract_citations","name":"Extract Citations","position":{"x":1290,"y":220},"config":{"answerPath":"answer","documentsPath":"documents"}},{"id":"output_1","type":"output","name":"Output","position":{"x":1600,"y":220},"config":{"responseTemplate":"{{answer}}","outputKey":"result"}}],"edges":[{"id":"edge_1","source":"text_1","target":"rag_1"},{"id":"edge_2","source":"rag_1","target":"template_1"},{"id":"edge_3","source":"text_1","target":"template_1"},{"id":"edge_4","source":"template_1","target":"llm_1"},{"id":"edge_5","source":"llm_1","target":"cite_1"},{"id":"edge_6","source":"rag_1","target":"cite_1"},{"id":"edge_7","source":"cite_1","target":"output_1"}],"projectId":"default","createdAt":"2026-10-26T16:18:23.600Z","updatedAt":"2026-10-26T16:18:23.600Z","tags":[]},{"id":"wf-rag-knowledge-base-flow","name":"RAG with Knowledge Base","description":"Text Input -> RAG Retrieve (built-in persistent KB) -> Prompt Template -> LLM -> Output. Demonstrates Phase 9.1 — query a long-lived KB without re-ingesting on every run. Replace `<your-kb-id>` with the id returned by POST /api/knowledge-bases. Ingest documents up front via POST /api/knowledge-bases/<id>/ingest (or the Studio UI in Phase 9.2). The same `embedderId` and `embedderConfig` used to create the KB must match here.","schemaVersion":"1.0.0","workflowVersion":1,"nodes":[{"id":"text_1","type":"text_input","name":"Question","position":{"x":70,"y":220},"config":{"text":"How do I reset my password?"}},{"id":"rag_1","type":"rag_retrieve","name":"RAG Retrieve (KB)","position":{"x":360,"y":220},"config":{"queryTemplate":"{{user_prompt}}","topK":3,"embedderId":"token-embedder","vectorStoreId":"knowledge-base","vectorStoreConfig":{"knowledgeBaseId":"<your-kb-id>"}}},{"id":"template_1","type":"prompt_template","name":"Grounded Prompt","position":{"x":670,"y":220},"config":{"template":"Use the context to answer the question. Cite the chunkId for every claim.\n\nContext:\n{{context}}\n\nQuestion:\n{{user_prompt}}","outputKey":"prompt"}},{"id":"llm_1","type":"llm_call","name":"LLM","position":{"x":980,"y":220},"config":{"provider":{"providerId":"echo","model":"echo-1"},"promptKey":"prompt"}},{"id":"output_1","type":"output","name":"Output","position":{"x":1290,"y":220},"config":{"responseTemplate":"{{answer}}","outputKey":"result"}}],"edges":[{"id":"edge_1","source":"text_1","target":"rag_1"},{"id":"edge_2","source":"rag_1","target":"template_1"},{"id":"edge_3","source":"text_1","target":"template_1"},{"id":"edge_4","source":"template_1","target":"llm_1"},{"id":"edge_5","source":"llm_1","target":"output_1"}],"projectId":"default","createdAt":"2026-10-26T16:18:23.598Z","updatedAt":"2026-10-26T16:18:23.598Z","tags":[]},{"id":"wf-structured-output","name":"Structured Output Parser Flow","description":"Text Input -> LLM Call -> Output Parser (json_schema mode) -> Output","schemaVersion":"1.0.0","workflowVersion":1,"nodes":[{"id":"input_1","type":"text_input","name":"Text Input","position":{"x":100,"y":180},"config":{"text":"Analyze the sentiment of: 'I love this product!'"}},{"id":"system_1","type":"system_prompt","name":"System Prompt","position":{"x":100,"y":60},"config":{"text":"You are a sentiment analysis assistant. Always respond with valid JSON containing 'name' and 'sentiment' fields."}},{"id":"llm_1","type":"llm_call","name":"LLM Call","position":{"x":380,"y":180},"config":{"provider":{"providerId":"ollama","baseUrl":"http://localhost:11434/v1","model":"llama3.1","temperature":0.1},"promptKey":"user_prompt","systemPromptKey":"system_prompt"}},{"id":"parser_1","type":"output_parser","name":"Output Parser","position":{"x":660,"y":180},"config":{"mode":"json_schema","inputKey":"answer","maxRetries":2,"jsonSchema":"{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\"},\"sentiment\":{\"type\":\"string\",\"enum\":[\"positive\",\"negative\",\"neutral\"]}},\"required\":[\"name\",\"sentiment\"]}"}},{"id":"output_1","type":"output","name":"Output","position":{"x":940,"y":180},"config":{"responseTemplate":"{{parsed}}","outputKey":"result"}}],"edges":[{"id":"e1","source":"system_1","target":"llm_1"},{"id":"e2","source":"input_1","target":"llm_1"},{"id":"e3","source":"llm_1","target":"parser_1"},{"id":"e4","source":"parser_1","target":"output_1"}],"projectId":"default","createdAt":"2026-10-26T16:18:23.597Z","updatedAt":"2026-10-26T16:18:23.597Z","tags":[]},{"id":"wf-conditional","name":"Conditional Branching Flow","description":"Webhook Input -> LLM Call -> IF Node (check for error) -> [true: Error Output] / [false: Success Output]","schemaVersion":"1.0.0","workflowVersion":1,"nodes":[{"id":"webhook_1","type":"webhook_input","name":"Webhook Input","position":{"x":100,"y":180},"config":{"path":"conditional-demo","method":"POST","passThroughFields":["system_prompt","user_prompt","session_id"]}},{"id":"llm_1","type":"llm_call","name":"LLM Call","position":{"x":380,"y":180},"config":{"provider":{"providerId":"ollama","baseUrl":"http://localhost:11434/v1","model":"llama3.1","temperature":0.2}}},{"id":"if_1","type":"if_node","name":"Check Answer","position":{"x":660,"y":180},"config":{"condition":"{{answer}}"}},{"id":"output_success","type":"output","name":"Success Output","position":{"x":940,"y":100},"config":{"responseTemplate":"{{answer}}","outputKey":"result"}},{"id":"output_error","type":"output","name":"Error Output","position":{"x":940,"y":260},"config":{"responseTemplate":"No answer generated","outputKey":"result"}}],"edges":[{"id":"e1","source":"webhook_1","target":"llm_1"},{"id":"e2","source":"llm_1","target":"if_1"},{"id":"e3","source":"if_1","sourceHandle":"true","target":"output_success"},{"id":"e4","source":"if_1","sourceHandle":"false","target":"output_error"}],"projectId":"default","createdAt":"2026-10-26T16:18:23.595Z","updatedAt":"2026-10-26T16:18:23.595Z","tags":[]},{"id":"wf-supervisor-worker-swarm","name":"Supervisor + Worker Swarm","description":"Multi-agent swarm pattern. A Supervisor coordinates two specialist Worker agents (a 'researcher' with MCP knowledge-base access and a 'computer' with calculator + time tools). Workers are exposed to the Supervisor as synthetic tools — the Supervisor decides which one to delegate each step to. Runs zero-key with the bundled echo provider and in-process mock-mcp adapter.","schemaVersion":"1.0.0","workflowVersion":1,"nodes":[{"id":"trigger_1","type":"manual_trigger","name":"Manual Trigger","position":{"x":80,"y":240},"config":{"label":"Run swarm"}},{"id":"supervisor_1","type":"supervisor_node","name":"Supervisor","position":{"x":360,"y":240},"config":{"systemPromptTemplate":"You are a supervisor. Decompose the user request, delegate each subtask to the most appropriate specialist worker, and assemble a final answer. Workers: 'researcher' for knowledge-base lookups, 'computer' for math and time queries.","userPromptTemplate":"{{user_prompt}}","sessionIdTemplate":"swarm-demo","maxIterations":8}},{"id":"supervisor_chat","type":"llm_call","name":"Supervisor Chat Model (echo)","position":{"x":360,"y":80},"config":{"provider":{"providerId":"echo","model":"demo","prefix":"Supervisor: "},"promptKey":"prompt","systemPromptKey":"system_prompt"}},{"id":"worker_research","type":"agent_orchestrator","name":"Worker: Researcher","position":{"x":660,"y":380},"config":{"systemPromptTemplate":"You answer factual questions by looking them up in the knowledge base via the lookup_kb MCP tool.","userPromptTemplate":"{{user_prompt}}","sessionIdTemplate":"swarm-demo:researcher","maxIterat