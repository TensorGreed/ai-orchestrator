{
  "name": "@ai-orchestrator/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:widget": "vite build --mode widget",
    "build:demo": "vite build --mode demo",
    "preview:demo": "vite preview --mode demo",
    "demo:record": "pnpm --filter @ai-orchestrator/api exec tsx ../web/demo/record-fixtures.mts",
    "e2e:demo": "playwright test --config playwright.demo.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@ai-orchestrator/shared": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reactflow": "^11.11.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "vite": "^7.1.3"
  }
}
