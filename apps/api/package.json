{
  "name": "@ai-orchestrator/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/index.ts",
    "test": "vitest run --passWithNoTests",
    "lint": "node scripts/check-floating-promises.mjs ../../packages/workflow-engine/tsconfig.json",
    "db:rollback": "tsx src/scripts/db-rollback.ts",
    "db:export": "tsx src/scripts/db-export.ts",
    "db:import": "tsx src/scripts/db-import.ts",
    "db:copy": "tsx src/scripts/db-copy.ts"
  },
  "dependencies": {
    "@ai-orchestrator/agent-runtime": "workspace:*",
    "@ai-orchestrator/community-sdk": "workspace:*",
    "@ai-orchestrator/connector-sdk": "workspace:*",
    "@ai-orchestrator/guard-sdk": "workspace:*",
    "@ai-orchestrator/mcp-sdk": "workspace:*",
    "@ai-orchestrator/provider-sdk": "workspace:*",
    "@ai-orchestrator/shared": "workspace:*",
    "@ai-orchestrator/workflow-engine": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^10.2.2",
    "better-sqlite3": "^11.7.0",
    "dotenv": "^17.2.2",
    "fastify": "^5.12.7",
    "fastify-raw-body": "5.0.0",
    "jose": "^6.2.13",
    "nanoid": "^5.1.5",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.2"
  }
}
