{
  "schemaVersion": "1.0.0",
  "workflowVersion": 1,
  "workflow": {
    "id": "starter-mcp-tool-call",
    "name": "Call an MCP tool",
    "description": "Calls the calculator tool of the built-in sample MCP server and returns its answer. Point the MCP Tool node at your own server when you are ready.",
    "schemaVersion": "1.0.0",
    "workflowVersion": 1,
    "nodes": [
      {
        "id": "start",
        "type": "manual_trigger",
        "name": "Run",
        "position": {
          "x": 80,
          "y": 200
        },
        "config": {
          "label": "Run manually",
          "testData": {
            "expression": "(19.99 * 3) + 4.5"
          }
        }
      },
      {
        "id": "tool",
        "type": "mcp_tool",
        "name": "Calculator",
        "position": {
          "x": 360,
          "y": 200
        },
        "config": {
          "serverId": "mock-mcp",
          "operation": "call_tool",
          "toolName": "calculator",
          "argsTemplate": "{\"expression\": {{ JSON.stringify(expression) }}}"
        }
      },
      {
        "id": "out",
        "type": "output",
        "name": "Result",
        "position": {
          "x": 640,
          "y": 200
        },
        "config": {
          "outputKey": "result"
        }
      }
    ],
    "edges": [
      {
        "id": "e_start_out_tool",
        "source": "start",
        "target": "tool"
      },
      {
        "id": "e_tool_out_out",
        "source": "tool",
        "target": "out"
      }
    ]
  },
  "exportedAt": "2026-11-19T00:00:00.000Z"
}
