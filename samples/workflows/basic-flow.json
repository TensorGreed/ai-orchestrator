{
  "schemaVersion": "1.0.0",
  "workflowVersion": 1,
  "workflow": {
    "id": "wf-basic-llm",
    "name": "Basic LLM Flow",
    "description": "Text Input -> Prompt Template -> LLM Call -> Output. Uses the built-in 'echo' provider so it runs end-to-end on a fresh install with no Ollama, no API keys, no setup. Swap the provider on the LLM Call node to a real one (Ollama, OpenAI, Anthropic, etc.) once you've verified the workflow runs.",
    "schemaVersion": "1.0.0",
    "workflowVersion": 1,
    "nodes": [
      {
        "id": "text_1",
        "type": "text_input",
        "name": "Text Input",
        "position": { "x": 80, "y": 140 },
        "config": {
          "text": "Hello from L2M! Replace this text and re-run to see the echo update."
        }
      },
      {
        "id": "template_1",
        "type": "prompt_template",
        "name": "Prompt Template",
        "position": { "x": 380, "y": 140 },
        "config": {
          "template": "{{user_prompt}}",
          "outputKey": "prompt"
        }
      },
      {
        "id": "llm_1",
        "type": "llm_call",
        "name": "LLM Call",
        "position": { "x": 700, "y": 140 },
        "config": {
          "provider": {
            "providerId": "echo",
            "model": "demo",
            "prefix": "Echo: "
          },
          "promptKey": "prompt",
          "systemPromptKey": "system_prompt"
        }
      },
      {
        "id": "output_1",
        "type": "output",
        "name": "Output",
        "position": { "x": 1000, "y": 140 },
        "config": {
          "responseTemplate": "{{answer}}",
          "outputKey": "result"
        }
      }
    ],
    "edges": [
      {
        "id": "edge_1",
        "source": "text_1",
        "target": "template_1"
      },
      {
        "id": "edge_2",
        "source": "template_1",
        "target": "llm_1"
      },
      {
        "id": "edge_3",
        "source": "llm_1",
        "target": "output_1"
      }
    ]
  },
  "exportedAt": "2026-03-30T00:00:00.000Z"
}