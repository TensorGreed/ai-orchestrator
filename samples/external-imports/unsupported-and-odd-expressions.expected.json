{
  "workflow": {
    "id": "wf-import-feedback_intake_mixed",
    "name": "Feedback intake (mixed)",
    "description": "Imported from an external workflow export (6 mapped, 5 approximated, 2 unsupported).",
    "schemaVersion": "1.0.0",
    "workflowVersion": 1,
    "variables": {
      "API_BASE": "",
      "region": ""
    },
    "nodes": [
      {
        "id": "feedback_form",
        "type": "form_trigger",
        "name": "Feedback form",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {
          "path": "feedback",
          "title": "Feedback",
          "fields": [
            {
              "name": "name",
              "label": "Name",
              "type": "text",
              "required": true
            },
            {
              "name": "rating",
              "label": "Rating",
              "type": "select",
              "required": false,
              "options": [
                "1",
                "2",
                "3"
              ]
            },
            {
              "name": "attachment",
              "label": "Attachment",
              "type": "text",
              "required": false
            }
          ],
          "authMode": "public",
          "description": "Tell us what you think",
          "submitLabel": "Send",
          "successMessage": "Thanks!"
        }
      },
      {
        "id": "slack",
        "type": "slack_send_message",
        "name": "Slack",
        "position": {
          "x": 240,
          "y": 0
        },
        "config": {
          "authType": "bot",
          "channel": "C123",
          "text": "New feedback from {{results.feedback_form.Name}}",
          "secretRef": {
            "secretId": "import-slack_bot_token-slack_bot"
          }
        }
      },
      {
        "id": "google_sheets",
        "type": "google_sheets_append",
        "name": "Google Sheets",
        "position": {
          "x": 480,
          "y": 0
        },
        "config": {
          "spreadsheetId": "1AbC",
          "range": "Feedback",
          "secretRef": {
            "secretId": "import-google_sheets_access_token-sheets_account"
          },
          "values": [],
          "valueInputOption": "USER_ENTERED"
        }
      },
      {
        "id": "odd_fields",
        "type": "set_node",
        "name": "Odd fields",
        "position": {
          "x": 720,
          "y": 0
        },
        "config": {
          "assignments": [
            {
              "key": "attachment",
              "valueTemplate": "{{ $binary.data.fileName }}"
            },
            {
              "key": "year",
              "valueTemplate": "{{ $now.toFormat('yyyy') }}"
            },
            {
              "key": "missing",
              "valueTemplate": "{{ $('Nope').item.json.value }}"
            },
            {
              "key": "apiBase",
              "valueTemplate": "{{vars.API_BASE}}"
            },
            {
              "key": "region",
              "valueTemplate": "{{vars.region}}"
            },
            {
              "key": "meta",
              "valueTemplate": "{{workflow.name}} / {{execution.id}}"
            },
            {
              "key": "day",
              "valueTemplate": "{{ $today.toISOString().slice(0, 10) }}"
            },
            {
              "key": "stamp",
              "valueTemplate": "{{ $now.toISOString() }}"
            },
            {
              "key": "fallback",
              "valueTemplate": "{{ $ifEmpty(results.google_sheets.Rating, 'n/a') }}"
            },
            {
              "key": "runs",
              "valueTemplate": "{{ $runIndex }}"
            }
          ]
        }
      },
      {
        "id": "python",
        "type": "code_node",
        "name": "Python",
        "position": {
          "x": 960,
          "y": 0
        },
        "config": {
          "language": "python",
          "mode": "runOnceForAllItems",
          "code": "for item in _input.all():\n    item.json['seen'] = True\nreturn _input.all()"
        }
      },
      {
        "id": "summarise",
        "type": "agent_orchestrator",
        "name": "Summarise",
        "position": {
          "x": 1200,
          "y": 0
        },
        "config": {
          "agentType": "tools",
          "systemPromptTemplate": "{{system_prompt}}",
          "userPromptTemplate": "{{user_prompt}}",
          "sessionIdTemplate": "{{session_id}}",
          "maxIterations": 10,
          "toolCallingEnabled": true
        }
      },
      {
        "id": "anthropic_chat_model",
        "type": "anthropic_chat_model",
        "name": "Anthropic Chat Model",
        "position": {
          "x": 1100,
          "y": 220
        },
        "config": {
          "model": "claude-3-5-sonnet-latest",
          "promptKey": "prompt",
          "systemPromptKey": "system_prompt",
          "temperature": 0,
          "secretRef": {
            "secretId": "import-anthropicapi-anthropic_account"
          }
        }
      },
      {
        "id": "calculator",
        "type": "noop_node",
        "name": "Calculator",
        "position": {
          "x": 1300,
          "y": 220
        },
        "config": {
          "label": "Unsupported: toolCalculator",
          "importedFrom": {
            "type": "@n8n/n8n-nodes-langchain.toolCalculator",
            "typeVersion": 1,
            "parameters": {},
            "credentials": {}
          }
        },
        "disabled": true
      },
      {
        "id": "embeddings_openai",
        "type": "noop_node",
        "name": "Embeddings OpenAI",
        "position": {
          "x": 1500,
          "y": 220
        },
        "config": {
          "label": "Unsupported: embeddingsOpenAi",
          "importedFrom": {
            "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
            "typeVersion": 1.2,
            "parameters": {
              "options": {}
            },
            "credentials": {}
          }
        },
        "disabled": true
      },
      {
        "id": "error_trigger",
        "type": "error_trigger",
        "name": "Error Trigger",
        "position": {
          "x": 0,
          "y": 400
        },
        "config": {}
      },
      {
        "id": "rss_feed_trigger",
        "type": "rss_trigger",
        "name": "RSS Feed Trigger",
        "position": {
          "x": 0,
          "y": 600
        },
        "config": {
          "feedUrl": "https://example.com/feed.xml",
          "pollIntervalSeconds": 900,
          "active": true
        }
      },
      {
        "id": "email_trigger_imap",
        "type": "imap_email_trigger",
        "name": "Email Trigger (IMAP)",
        "position": {
          "x": 0,
          "y": 800
        },
        "config": {
          "host": "",
          "port": 993,
          "secure": true,
          "user": "",
          "mailbox": "INBOX",
          "pollIntervalSeconds": 60,
          "secretRef": {
            "secretId": "import-imap-support_inbox"
          }
        }
      },
      {
        "id": "top_ratings",
        "type": "filter_node",
        "name": "Top ratings",
        "position": {
          "x": 1440,
          "y": 0
        },
        "config": {
          "conditions": [
            {
              "field": "results.summarise.Rating",
              "operator": "eq",
              "value": "3"
            }
          ],
          "combineWith": "AND",
          "passMode": "pass"
        }
      },
      {
        "id": "import_output",
        "type": "output",
        "name": "Output",
        "position": {
          "x": 1780,
          "y": 450
        },
        "config": {
          "outputKey": "result"
        }
      }
    ],
    "edges": [
      {
        "id": "edge_1",
        "source": "feedback_form",
        "target": "slack"
      },
      {
        "id": "edge_2",
        "source": "slack",
        "target": "google_sheets"
      },
      {
        "id": "edge_3",
        "source": "google_sheets",
        "target": "odd_fields"
      },
      {
        "id": "edge_4",
        "source": "odd_fields",
        "target": "python"
      },
      {
        "id": "edge_5",
        "source": "python",
        "target": "summarise"
      },
      {
        "id": "edge_6",
        "source": "summarise",
        "target": "top_ratings"
      },
      {
        "id": "edge_chat_model_7",
        "source": "summarise",
        "target": "anthropic_chat_model",
        "sourceHandle": "chat_model"
      },
      {
        "id": "edge_8",
        "source": "error_trigger",
        "target": "import_output"
      },
      {
        "id": "edge_9",
        "source": "rss_feed_trigger",
        "target": "import_output"
      },
      {
        "id": "edge_10",
        "source": "email_trigger_imap",
        "target": "import_output"
      },
      {
        "id": "edge_11",
        "source": "top_ratings",
        "target": "import_output"
      }
    ]
  },
  "report": {
    "sourceName": "Feedback intake (mixed)",
