{
  "workflow": {
    "id": "wf-import-bug_triage",
    "name": "Bug triage",
    "description": "Imported from an external workflow export (4 mapped, 5 approximated, 3 unsupported).",
    "schemaVersion": "1.0.0",
    "workflowVersion": 1,
    "nodes": [
      {
        "id": "github_trigger",
        "type": "github_webhook_trigger",
        "name": "GitHub Trigger",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {
          "path": "github_trigger",
          "secretRef": {
            "secretId": "import-github_webhook_secret-github_bot"
          }
        }
      },
      {
        "id": "comment_on_issue",
        "type": "github_action",
        "name": "Comment on issue",
        "position": {
          "x": 240,
          "y": 0
        },
        "config": {
          "secretRef": {
            "secretId": "import-github_personal_access_token-github_bot"
          },
          "owner": "tensorgreed",
          "repo": "ai-orchestrator",
          "operation": "commentIssue",
          "issueNumber": "{{results.github_trigger.body.issue.number}}",
          "body": "Thanks {{results.github_trigger.body.issue.user.login}}, we're on it."
        }
      },
      {
        "id": "create_issue",
        "type": "github_action",
        "name": "Create issue",
        "position": {
          "x": 480,
          "y": 0
        },
        "config": {
          "secretRef": {
            "secretId": "import-github_personal_access_token-github_bot"
          },
          "owner": "tensorgreed",
          "repo": "ai-orchestrator",
          "operation": "createIssue",
          "title": "[triage] {{results.comment_on_issue.body.issue.title}}",
          "body": "Mirrored from #{{results.comment_on_issue.body.issue.number}}"
        }
      },
      {
        "id": "close_issue",
        "type": "github_action",
        "name": "Close issue",
        "position": {
          "x": 720,
          "y": 0
        },
        "config": {
          "secretRef": {
            "secretId": "import-github_personal_access_token-github_bot"
          },
          "owner": "tensorgreed",
          "repo": "ai-orchestrator",
          "operation": "closeIssue",
          "issueNumber": 42
        }
      },
      {
        "id": "read_changelog",
        "type": "github_action",
        "name": "Read changelog",
        "position": {
          "x": 0,
          "y": 200
        },
        "config": {
          "secretRef": {
            "secretId": "import-github_personal_access_token-github_bot"
          },
          "owner": "tensorgreed",
          "repo": "ai-orchestrator",
          "operation": "getFile",
          "path": "CHANGELOG.md"
        }
      },
      {
        "id": "create_release",
        "type": "noop_node",
        "name": "Create release",
        "position": {
          "x": 240,
          "y": 200
        },
        "config": {
          "label": "Unsupported: github",
          "importedFrom": {
            "type": "n8n-nodes-base.github",
            "typeVersion": 1.1,
            "parameters": {
              "resource": "release",
              "operation": "create",
              "owner": {
                "__rl": true,
                "value": "tensorgreed",
                "mode": "list",
                "cachedResultName": "tensorgreed"
              },
              "repository": {
                "__rl": true,
                "value": "ai-orchestrator",
                "mode": "list",
                "cachedResultName": "ai-orchestrator"
              },
              "releaseTag": "=v{{ $json.version }}"
            },
            "credentials": {
              "githubApi": "GitHub bot"
            }
          }
        },
        "disabled": true
      },
      {
        "id": "jira_ticket",
        "type": "jira_create_issue",
        "name": "Jira ticket",
        "position": {
          "x": 480,
          "y": 200
        },
        "config": {
          "baseUrl": "",
          "email": "",
          "secretRef": {
            "secretId": "import-jira_api_token-jira_cloud"
          },
          "projectKey": "10001",
          "issueType": "Bug",
          "summary": "{{results.create_issue.title}}",
          "description": "See {{results.create_issue.html_url}}",
          "fieldsJson": "{\"labels\":[\"imported\"],\"priority\":{\"id\":\"3\"}}"
        }
      },
      {
        "id": "find_open_bugs",
        "type": "jira_search_issues",
        "name": "Find open bugs",
        "position": {
          "x": 720,
          "y": 200
        },
        "config": {
          "baseUrl": "",
          "email": "",
          "secretRef": {
            "secretId": "import-jira_api_token-jira_cloud"
          },
          "jql": "project = PLAT AND status != Done",
          "maxResults": 20
        }
      },
      {
        "id": "jira_comment",
        "type": "noop_node",
        "name": "Jira comment",
        "position": {
          "x": 0,
          "y": 400
        },
        "config": {
          "label": "Unsupported: jira",
          "importedFrom": {
            "type": "n8n-nodes-base.jira",
            "typeVersion": 1,
            "parameters": {
              "resource": "issueComment",
              "operation": "add",
              "issueKey": "={{ $json.key }}",
              "comment": "=Imported"
            },
            "credentials": {
              "jiraSoftwareCloudApi": "Jira cloud"
            }
          }
        },
        "disabled": true
      },
      {
        "id": "notion_page",
        "type": "notion_create_page",
        "name": "Notion page",
        "position": {
          "x": 240,
          "y": 400
        },
        "config": {
          "secretRef": {
            "secretId": "import-notion_integration_token-notion_workspace"
          },
          "databaseId": "8f3c5c1a2b3d4e5f8a9b0c1d2e3f4a5b",
          "titleProperty": "Name",
          "title": "{{results.create_issue.title}}",
          "propertiesJson": "{\"Status\":{\"select\":{\"name\":\"Triage\"}},\"Priority\":{\"number\":2},\"Tags\":{\"multi_select\":[{\"name\":\"bug\"},{\"name\":\"import\"}]}}"
        }
      },
      {
        "id": "notion_query",
        "type": "notion_query_database",
        "name": "Notion query",
        "position": {
          "x": 480,
          "y": 400
        },
        "config": {
          "secretRef": {
            "secretId": "import-notion_integration_token-notion_workspace"
          },
          "databaseId": "8f3c5c1a2b3d4e5f8a9b0c1d2e3f4a5b",
          "pageSize": 25,
          "filterJson": "{\"property\":\"Status\",\"select\":{\"equals\":\"{{results.find_open_bugs.status}}\"}}",
          "sortsJson": "[{\"timestamp\":\"created_time\",\"direction\":\"descending\"},{\"property\":\"Priority\",\"direction\":\"ascending\"}]"
        }
      },
      {
        "id": "notion_block",
        "type": "noop_node",
        "name": "Notion block",
        "position": {
          "x": 720,
          "y": 400
        },
        "config": {
          "label": "Unsupported: notion",
          "importedFrom": {
            "type": "n8n-nodes-base.notion",
            "typeVersion": 2.2,
            "parameters": {
              "resource": "block",
              "operation": "append",
              "blockId": {
                "__rl": true,
                "value": "abc",
                "mode": "id"
              },
              "blockUi": {}
            },
            "credentials": {
              "notionApi": "Notion workspace"
            }
          }
        },
        "disabled": true
      },
      {
        "id": "import_output",
        "type": "output",
        "name": "Output",
        "position": {
          "x": 1000,
          "y": 350
        },
        "config": {
          "outputKey": "result"
        }
      }
    ],
    "edges": [
