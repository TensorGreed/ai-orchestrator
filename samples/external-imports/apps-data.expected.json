{
  "workflow": {
    "id": "wf-import-nightly_data_sync",
    "name": "Nightly data sync",
    "description": "Imported from an external workflow export (5 mapped, 8 approximated, 4 unsupported).",
    "schemaVersion": "1.0.0",
    "workflowVersion": 1,
    "nodes": [
      {
        "id": "sheets_trigger",
        "type": "google_sheets_trigger",
        "name": "Sheets Trigger",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {
          "spreadsheetId": "1AbCdEfGhIjKlMnOp",
          "range": "Orders!A:Z",
          "authType": "accessToken",
          "secretRef": {
            "secretId": "import-google_sheets_access_token-sheets_account"
          },
          "pollIntervalSeconds": 900
        }
      },
      {
        "id": "read_orders",
        "type": "google_sheets_read",
        "name": "Read orders",
        "position": {
          "x": 240,
          "y": 0
        },
        "config": {
          "spreadsheetId": "1AbCdEfGhIjKlMnOp",
          "range": "Orders!A:F",
          "authType": "accessToken",
          "secretRef": {
            "secretId": "import-google_sheets_access_token-sheets_account"
          }
        }
      },
      {
        "id": "append_summary",
        "type": "google_sheets_append",
        "name": "Append summary",
        "position": {
          "x": 480,
          "y": 0
        },
        "config": {
          "spreadsheetId": "1AbCdEfGhIjKlMnOp",
          "range": "Summary",
          "secretRef": {
            "secretId": "import-google_sheets_access_token-sheets_account"
          },
          "values": [
            [
              "{{ $now.toISOString() }}",
              "{{results.read_orders.values.length}}"
            ]
          ],
          "valueInputOption": "RAW"
        }
      },
      {
        "id": "upsert_customer",
        "type": "google_sheets_append",
        "name": "Upsert customer",
        "position": {
          "x": 720,
          "y": 0
        },
        "config": {
          "spreadsheetId": "1AbCdEfGhIjKlMnOp",
          "range": "Customers",
          "secretRef": {
            "secretId": "import-google_sheets_access_token-sheets_account"
          },
          "values": [],
          "valueInputOption": "USER_ENTERED"
        }
      },
      {
        "id": "clear_sheet",
        "type": "noop_node",
        "name": "Clear sheet",
        "position": {
          "x": 0,
          "y": 200
        },
        "config": {
          "label": "Unsupported: googleSheets",
          "importedFrom": {
            "type": "n8n-nodes-base.googleSheets",
            "typeVersion": 4.5,
            "parameters": {
              "operation": "clear",
              "documentId": {
                "__rl": true,
                "value": "1AbCdEfGhIjKlMnOp",
                "mode": "id"
              },
              "sheetName": {
                "__rl": true,
                "value": "Scratch",
                "mode": "name"
              }
            },
            "credentials": {
              "googleSheetsOAuth2Api": "Sheets account"
            }
          }
        },
        "disabled": true
      },
      {
        "id": "load_orders",
        "type": "postgres_query",
        "name": "Load orders",
        "position": {
          "x": 240,
          "y": 200
        },
        "config": {
          "host": "",
          "port": 5432,
          "database": "",
          "user": "",
          "ssl": false,
          "secretRef": {
            "secretId": "import-postgres_password-warehouse"
          },
          "query": "SELECT * FROM orders WHERE created_at > $1",
          "params": [
            "{{results.read_orders.since}}"
          ]
        }
      },
      {
        "id": "recent_customers",
        "type": "postgres_query",
        "name": "Recent customers",
        "position": {
          "x": 480,
          "y": 200
        },
        "config": {
          "host": "",
          "port": 5432,
          "database": "",
          "user": "",
          "ssl": false,
          "secretRef": {
            "secretId": "import-postgres_password-warehouse"
          },
          "query": "SELECT * FROM \"public\".\"customers\" WHERE \"status\" = $1 AND \"deleted_at\" IS NULL ORDER BY \"created_at\" DESC LIMIT 100",
          "params": [
            "active"
          ]
        }
      },
      {
        "id": "insert_rows",
        "type": "noop_node",
        "name": "Insert rows",
        "position": {
          "x": 720,
          "y": 200
        },
        "config": {
          "label": "Unsupported: postgres",
          "importedFrom": {
            "type": "n8n-nodes-base.postgres",
            "typeVersion": 2.4,
            "parameters": {
              "schema": {
                "__rl": true,
                "value": "public",
                "mode": "list"
              },
              "table": {
                "__rl": true,
                "value": "order_log",
                "mode": "list"
              },
              "columns": {
                "mappingMode": "autoMapInputData"
              }
            },
            "credentials": {
              "postgres": "Warehouse"
            }
          }
        },
        "disabled": true
      },
      {
        "id": "postgres_trigger",
        "type": "postgres_trigger",
        "name": "Postgres Trigger",
        "position": {
          "x": 0,
          "y": 400
        },
        "config": {
          "host": "",
          "port": 5432,
          "database": "",
          "user": "",
          "ssl": false,
          "secretRef": {
            "secretId": "import-postgres_password-warehouse"
          },
          "query": "SELECT * FROM \"public\".\"orders\"",
          "pollIntervalSeconds": 60
        }
      },
      {
        "id": "list_leads",
        "type": "airtable_list_records",
        "name": "List leads",
        "position": {
          "x": 240,
          "y": 400
        },
        "config": {
          "secretRef": {
            "secretId": "import-airtable_personal_access_token-airtable_pat"
          },
          "baseId": "appAbCdEf12345678",
          "table": "tblAbCdEf12345678",
          "filterByFormula": "{Status} = 'New'",
          "maxRecords": 50,
          "view": "viwAbCdEf12345678"
        }
      },
      {
        "id": "create_lead",
        "type": "airtable_create_record",
        "name": "Create lead",
        "position": {
          "x": 480,
          "y": 400
        },
        "config": {
          "secretRef": {
            "secretId": "import-airtable_personal_access_token-airtable_pat"
          },
          "baseId": "appAbCdEf12345678",
          "table": "tblAbCdEf12345678",
          "fieldsJson": "{\"Name\":\"{{results.list_leads.fields.Name}}\",\"Status\":\"Contacted\"}",
          "typecast": true
        }
      },
      {
        "id": "update_lead",
        "type": "airtable_update_record",
        "name": "Update lead",
        "position": {
          "x": 720,
          "y": 400
        },
        "config": {
          "secretRef": {
            "secretId": "import-airtable_personal_access_token-airtable_pat"
          },
          "baseId": "appAbCdEf12345678",
          "table": "tblAbCdEf12345678",
          "recordId": "{{results.create_lead.id}}",
          "fieldsJson": "{\"Status\":\"Done\"}"
        }
      },
      {
        "id": "delete_lead",
        "type": "noop_node",
        "name": "Delete lead",
        "position": {
          "x": 0,
          "y": 600
        },
        "config": {
          "label": "Unsupported: airtable",
          "importedFrom": {
            "type": "n8n-nodes-base.airtable",
            "typeVersion": 2.1,
            "parameters": {
              "operation": "deleteRecord",
              "base": {
                "__rl": true,
                "value": "appAbCdEf12345678",
                "mode": "list",
                "cachedResultName": "CRM"
              },
              "table": {
                "__rl": true,
                "value": "tblAbCdEf12345678",
                "mode": "list",
                "cachedResultName": "Leads"
              },
              "id": "={{ $json.id }}"
            },
            "credentials": {
              "airtableTokenApi": "Airtable PAT"
            }
          }
        },
        "disabled": true
      },
      {
        "id": "download_report",
        "type": "aws_s3_get_object",
        "name": "Download report",
        "position": {
          "x": 240,
          "y": 600
        },
        "config": {
          "region": "us-east-1",
          "bucket": "acme-reports",
          "secretRef": {
            "secretId": "import-aws_access_key_pair-aws_prod"
          },
          "key": "reports/{{results.recent_customers.date}}.csv"
        }
      },
      {
        "id": "upload_digest",
        "type": "aws_s3_put_object",
        "name": "Upload digest",
        "position": {
          "x": 480,
          "y": 600
        },
        "config": {
          "region": "us-east-1",
          "bucket": "acme-reports",
          "secretRef": {
            "secretId": "import-aws_access_key_pair-aws_prod"
          },
          "key": "digests/digest-{{ $now.toISOString() }}.txt",
          "body": "{{results.download_report.summary}}",
          "contentType": "text/plain"
        }
      },
      {
        "id": "list_reports",
        "type": "aws_s3_list_objects",
        "name": "List reports",
        "position": {
          "x": 720,
          "y": 600
        },
        "config": {
          "region": "us-east-1",
          "bucket": "acme-reports",
          "secretRef": {
            "secretId": "import-aws_access_key_pair-aws_prod"
          },
          "prefix": "reports/",
          "maxKeys": 20
        }
      },
      {
        "id": "create_bucket",
        "type": "noop_node",
        "name": "Create bucket",
        "position": {
          "x": 0,
          "y": 800
        },
        "config": {
          "label": "Unsupported: awsS3",
          "importedFrom": {
            "type": "n8n-nodes-base.awsS3",
            "typeVersion": 2,
            "parameters": {
              "resource": "bucket",
              "operation": "create",
              "name": "acme-archive"
            },
            "credentials": {
              "aws": "AWS prod"
            }
          }
        },
        "disabled": true
      },
      {
        "id": "import_output",
        "type": "output",
        "name": "Output",
        "position": {
          "x": 1000,
          "y": 450
        },
        "config": {
          "outputKey": "result"
        }
      }
    ],
