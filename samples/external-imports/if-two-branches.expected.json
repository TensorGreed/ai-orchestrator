          "x": 0,
          "y": 0
        },
        "config": {
          "label": "When clicking ‘Test workflow’"
        }
      },
      {
        "id": "sample_order",
        "type": "set_node",
        "name": "Sample Order",
        "position": {
          "x": 220,
          "y": 0
        },
        "config": {
          "assignments": [
            {
              "key": "status",
              "valueTemplate": "active"
            },
            {
              "key": "amount",
              "valueTemplate": "250"
            }
          ]
        }
      },
      {
        "id": "needs_approval",
        "type": "if_node",
        "name": "Needs approval?",
        "position": {
          "x": 440,
          "y": 0
        },
        "config": {
          "condition": "{{ (String(results.sample_order.status ?? \"\") === \"active\") && (Number(results.sample_order.amount) > Number(100)) }}",
          "trueLabel": "true",
          "falseLabel": "false"
        }
      },
      {
        "id": "request_approval",
        "type": "http_request",
        "name": "Request approval",
        "position": {
          "x": 680,
          "y": -120
        },
        "config": {
          "method": "POST",
          "urlTemplate": "https://hooks.example.com/approvals",
          "responseType": "json",
          "bodyTemplate": "{\n  \"amount\": {{results.needs_approval.amount}},\n  \"requestedBy\": \"{{results.sample_order.status}}\"\n}"
        }
      },
      {
        "id": "auto_approve",
        "type": "noop_node",
        "name": "Auto approve",
        "position": {
          "x": 680,
          "y": 140
        },
        "config": {
          "label": "Auto approve"
        }
      },
      {
        "id": "sticky_note",
