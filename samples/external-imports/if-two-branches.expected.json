        "name": "Sticky Note",
        "position": {
          "x": 380,
          "y": -220
        },
        "config": {
          "content": "## Approval rule\nOrders above 100 go to a human.",
          "color": "green",
          "fontSize": 14,
          "width": 260,
          "height": 120
        }
      },
      {
        "id": "import_output",
        "type": "output",
        "name": "Output",
        "position": {
