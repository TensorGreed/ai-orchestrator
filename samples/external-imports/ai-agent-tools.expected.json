        "target": "simple_memory",
        "sourceHandle": "memory"
      },
      {
        "id": "edge_tool_5",
        "source": "ai_agent",
        "target": "orders_mcp",
        "sourceHandle": "tool"
      },
      {
        "id": "edge_tool_6",
        "source": "ai_agent",
        "target": "shipping_mcp",
        "sourceHandle": "tool"
      },
      {
        "id": "edge_7",
        "source": "ai_agent",
        "target": "structured_output_parser"
      },
      {
        "id": "edge_8",
        "source": "format_reply",
        "target": "import_output"
      }
    ]
  },
