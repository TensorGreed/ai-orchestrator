{
  "workflow": {
    "id": "wf-import-support_agent",
    "name": "Support agent",
    "description": "Imported from an external workflow export (6 mapped, 2 approximated, 0 unsupported).",
    "schemaVersion": "1.0.0",
    "workflowVersion": 1,
    "nodes": [
      {
        "id": "chat",
        "type": "chat_trigger",
        "name": "Chat",
        "position": {
          "x": 0,
          "y": 0
        },
        "config": {
          "path": "chat",
          "authMode": "public",
          "persistMessages": true,
          "sessionNamespace": "support_agent",
          "welcomeMessage": "Hi! How can I help with your order?"
        }
      },
      {
        "id": "ai_agent",
        "type": "agent_orchestrator",
        "name": "AI Agent",
        "position": {
          "x": 260,
          "y": 0
        },
        "config": {
          "agentType": "tools",
          "systemPromptTemplate": "You are a support agent for Example Shop. Use the tools to look up orders.",
          "userPromptTemplate": "{{results.chat.chatInput}}",
          "sessionIdTemplate": "{{session_id}}",
          "maxIterations": 8,
          "toolCallingEnabled": true
        }
      },
      {
        "id": "openai_chat_model",
        "type": "openai_chat_model",
        "name": "OpenAI Chat Model",
        "position": {
          "x": 120,
          "y": 220
        },
        "config": {
          "model": "gpt-4o-mini",
          "promptKey": "prompt",
          "systemPromptKey": "system_prompt",
          "temperature": 0.3,
          "maxTokens": 2048,
          "secretRef": {
            "secretId": "import-openaiapi-openai_account"
          }
        }
      },
      {
        "id": "simple_memory",
        "type": "local_memory",
        "name": "Simple Memory",
        "position": {
          "x": 280,
          "y": 220
        },
        "config": {
          "namespace": "support_agent",
          "sessionIdTemplate": "{{ $json.sessionId }}",
          "maxMessages": 12,
          "persistToolMessages": false
        }
      },
      {
        "id": "orders_mcp",
        "type": "mcp_tool",
        "name": "Orders MCP",
        "position": {
          "x": 440,
          "y": 220
        },
        "config": {
          "serverId": "orders_mcp",
          "toolName": "lookup_order",
          "argsTemplate": "{}",
          "connection": {
            "endpoint": "https://mcp.example.com/orders/mcp",
            "transport": "http_streamable",
            "authType": "bearer"
          },
          "allowedTools": [
            "lookup_order"
          ],
          "secretRef": {
            "secretId": "import-httpbearerauth-orders_mcp_token"
          }
        }
      },
      {
        "id": "shipping_mcp",
        "type": "mcp_tool",
        "name": "Shipping MCP",
        "position": {
          "x": 600,
          "y": 220
        },
        "config": {
          "serverId": "shipping_mcp",
          "toolName": "__all__",
          "argsTemplate": "{}",
          "connection": {
            "endpoint": "https://mcp.example.com/shipping/sse",
            "transport": "http_streamable",
            "authType": "none"
          }
        }
      },
      {
        "id": "structured_output_parser",
        "type": "output_parser",
        "name": "Structured Output Parser",
        "position": {
          "x": 760,
          "y": 220
        },
        "config": {
          "mode": "json_schema",
          "parsingMode": "lenient",
          "jsonSchema": "{\"type\":\"object\",\"properties\":{\"answer\":{\"type\":\"string\"},\"orderId\":{\"type\":\"string\"},\"escalate\":{\"type\":\"boolean\"}},\"required\":[\"answer\",\"orderId\",\"escalate\"]}",
          "inputKey": "answer",
          "maxRetries": 0
        }
      },
      {
        "id": "format_reply",
        "type": "set_node",
        "name": "Format reply",
        "position": {
          "x": 640,
          "y": 0
        },
        "config": {
          "assignments": [
            {
              "key": "reply",
              "valueTemplate": "{{results.ai_agent.output.answer}}"
            }
          ]
        }
      },
      {
        "id": "import_output",
        "type": "output",
        "name": "Output",
        "position": {
          "x": 1040,
          "y": 0
        },
        "config": {
          "outputKey": "result"
        }
      }
    ],
    "edges": [
      {
        "id": "edge_1",
        "source": "chat",
        "target": "ai_agent"
      },
      {
        "id": "edge_2",
        "source": "structured_output_parser",
        "target": "format_reply"
      },
      {
        "id": "edge_chat_model_3",
