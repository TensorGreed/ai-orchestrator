# API
LOG_LEVEL=warn
API_PORT=4000
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
API_BODY_LIMIT_BYTES=10485760
WORKFLOW_EXECUTION_TIMEOUT_MS=1200000
# Interval for the `: ping` keep-alive on streamed runs (max 30000; the web client gives up after 45s of silence)
SSE_HEARTBEAT_INTERVAL_MS=15000
EXECUTION_HISTORY_RETENTION_DAYS=30
EXECUTION_HISTORY_PRUNE_INTERVAL_MS=3600000
QUEUE_CONCURRENCY=5
# Re-queue a job still running after this long. Raised automatically to WORKFLOW_EXECUTION_TIMEOUT_MS + 60s when lower.
QUEUE_STUCK_JOB_TIMEOUT_MS=600000
SEED_SAMPLE_WORKFLOWS=false
SESSION_COOKIE_NAME=ao_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# Rate limits (on by default; RATE_LIMIT_ENABLED=false turns them off). Per client address and route; a request over
# a limit gets 429 with Retry-After. Signed-in browser requests are not counted in the global bucket.
# RATE_LIMIT_ENABLED=true
# Sign-in, its TOTP step, registration, LDAP/OIDC/SAML sign-in, TOTP enrolment checks.
# RATE_LIMIT_AUTH_MAX=10
# RATE_LIMIT_AUTH_WINDOW_MS=60000
# /webhook/*, /webhook-test/*, /api/webhooks/*.
# RATE_LIMIT_WEBHOOK_MAX=120
# RATE_LIMIT_WEBHOOK_WINDOW_MS=60000
# Every other route, for unauthenticated and API-key/bearer requests.
# RATE_LIMIT_GLOBAL_MAX=600
# RATE_LIMIT_GLOBAL_WINDOW_MS=60000
# Reverse proxies whose X-Forwarded-For names the client (unset = none: the connecting address counts, so behind a
# proxy every client shares one count). Comma list of addresses/CIDRs (or loopback, linklocal, uniquelocal), a hop
# count, or true. Only trust proxies that overwrite the header, and keep the API reachable only through them.
# TRUST_PROXY=10.0.0.0/8

# Database
# Leave DB_TYPE=sqlite for the default apps/api/data/orchestrator.db store.
# Set DB_TYPE=postgres to use the PostgreSQL settings below (checked at startup only then).
DB_TYPE=sqlite
# Optional: another SQLite file (relative to the directory the API starts in).
# DB_SQLITE_PATH=./data/orchestrator.db
# PostgreSQL settings (only read when DB_TYPE=postgres). The values shown are the defaults the code uses; uncomment
# only what you change.
# DB_POSTGRESDB_HOST=localhost
# DB_POSTGRESDB_PORT=5432
# DB_POSTGRESDB_DATABASE=ai_orchestrator
# DB_POSTGRESDB_USER=postgres
# DB_POSTGRESDB_PASSWORD=
# DB_POSTGRESDB_SSL=false
# DB_POSTGRESDB_POOL_SIZE=10
# Optional: one URL instead of the separate settings above (it wins when set).
# sslmode=require / verify-ca / verify-full turn TLS on, sslmode=disable off; allow and prefer are refused (use
# require or disable). All three TLS modes verify the server certificate and host name here (stricter than libpq's
# require): for a provider with a private CA set DB_POSTGRESDB_SSL_CA. No other URL parameters are read.
# If DB_POSTGRESDB_SSL is also set it must agree with sslmode, or startup fails.
# DB_POSTGRESDB_URL=postgres://user:password@host:5432/ai_orchestrator?sslmode=verify-full
# With TLS on, the server certificate is verified against the system CAs. For a private CA give its PEM
# (or the path of a PEM file):
# DB_POSTGRESDB_SSL_CA=/etc/ssl/certs/my-db-ca.pem
# Not recommended: turn certificate verification off (a startup warning says so).
# DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=false

# Auth bootstrap and registration controls
AUTH_ALLOW_PUBLIC_REGISTER=false
# Project isolation for non-admins without a membership in a project:
# role = fall back to their global role there (default); strict = no access,
# so they only see the projects they are a member of (default project included),
# and default-project secrets must be shared to each project that uses them.
PROJECT_ISOLATION=role
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisPassword123!

# Secret encryption (32-byte key as base64; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
SECRET_MASTER_KEY_BASE64=replace-with-32-byte-base64-key

# Optional provider and vector store keys
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_AI_SEARCH_API_KEY=
AZURE_AI_SEARCH_ENDPOINT=
QDRANT_API_KEY=
QDRANT_ENDPOINT=http://localhost:6333
PINECONE_API_KEY=
# Used by RAG Retrieve when vectorStoreId=pgvector-store
DATABASE_URL=

# Default local Ollama URL
OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional Python binary override for Python code node
PYTHON_BIN=

# Optional: path to Chromium/Chrome executable for HTML PDF rendering (pdf_output renderMode=html)
PDF_CHROMIUM_EXECUTABLE_PATH=

# ---------------------------------------------------------------------------
# Phase 5.1 — Enterprise authentication
# ---------------------------------------------------------------------------

# API keys. 0 = never expire (a default; individual keys can still set their own expiry).
API_KEY_DEFAULT_EXPIRY_DAYS=0

# MFA (TOTP). MFA_ENFORCE=true requires admins to enrol before issuing a session.
MFA_ENABLED=false
MFA_ENFORCE=false
MFA_ISSUER=ai-orchestrator

# SAML 2.0 SSO. Requires optional dep: `pnpm add -w @node-saml/node-saml` (install in apps/api).
SAML_ENABLED=false
SAML_ENTRY_POINT=
SAML_ISSUER=
SAML_CALLBACK_URL=
# PEM-encoded IdP signing certificate (single line — replace newlines with \n).
SAML_IDP_CERT=
# SAML response attribute that carries group memberships (for group-to-role mapping).
SAML_GROUPS_ATTRIBUTE=groups
# Optional (read only when SAML_ENABLED=true). The IdP's entity ID; assertions from another Issuer are refused.
# Must not contain '#'. Unset = not pinned (the IdP certificate still is).
# SAML_IDP_ISSUER=https://sts.windows.net/<tenant-id>/
# Optional allow-lists, same rules as OIDC_ALLOWED_* (unset = no restriction); SAML trusts the asserted email.
# SAML_ALLOWED_EMAIL_DOMAINS=example.com
# SAML_ALLOWED_GROUPS=l2m-users

# LDAP / Active Directory. Requires optional dep: `pnpm add -w ldapts` (install in apps/api).
LDAP_ENABLED=false
LDAP_URL=ldap://ldap.example.com:389
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=
# User search filter; {{email}} is replaced with the login email.
LDAP_USER_FILTER=(mail={{email}})
# Attribute that carries group memberships (e.g. memberOf for Active Directory).
LDAP_GROUPS_ATTRIBUTE=memberOf

# OpenID Connect SSO (Authorization Code + PKCE). Off unless OIDC_ENABLED=true; nothing else is read until then.
# Register the redirect URL below at your IdP. See the Authentication and RBAC docs page for Keycloak, Entra ID, Okta.
# OIDC_ENABLED=false
# Must equal the IdP's `issuer` exactly (https; plain http only on localhost).
# OIDC_ISSUER=https://keycloak.example.com/realms/l2m
# OIDC_CLIENT_ID=l2m
# Leave unset for a public client (PKCE only). Never logged or returned by the API.
# OIDC_CLIENT_SECRET=
# Default: <first WEB_ORIGIN>/api/auth/oidc/callback
# OIDC_REDIRECT_URL=https://l2m.example.com/api/auth/oidc/callback
# OIDC_SCOPES=openid email profile
# ID token / userinfo claim with group names, for SSO group-to-role mappings (dotted paths such as realm_access.roles work).
# OIDC_GROUPS_CLAIM=groups
# Link or create users by email only when the IdP sends email_verified=true. Set false only if your IdP controls
# every email address and does not send email_verified (some Entra ID setups).
# OIDC_REQUIRE_EMAIL_VERIFIED=true
# Optional allow-lists (unset = no restriction). Without them, ANY account your IdP authenticates gets a viewer
# account here; set at least one for Google, multi-tenant or self-registration IdPs.
# Comma list of email domains, matched exactly (case-insensitive) on the verified email's domain.
# OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# Comma list of group names (from OIDC_GROUPS_CLAIM); the user must hold at least one.
# OIDC_ALLOWED_GROUPS=l2m-users

# MFA on SSO (OIDC and SAML; read only when one of them is on). off (default) = as before;
# idp = the IdP must assert MFA, else sso_error=sso_mfa_required;
# idp_or_local = IdP MFA, else the local TOTP step for users who enrolled it (MFA_ENFORCE rules otherwise).
# SSO_MFA=off
# OIDC amr values (RFC 8176) that count as MFA.
# SSO_MFA_OIDC_AMR=mfa,mca,otp,hwk,swk,sms
# OIDC acr values that count as MFA; when set they are also requested with acr_values. Default: none.
# SSO_MFA_OIDC_ACR=
# SAML AuthnContextClassRef values that count as MFA. Default: REFEDS MFA, Entra multipleauthn, MultiFactor,
# MobileTwoFactorContract, MobileTwoFactorUnregistered, SmartcardPKI (full URIs in the docs).
# SSO_MFA_SAML_AUTHN_CONTEXTS=https://refeds.org/profile/mfa,http://schemas.microsoft.com/claims/multipleauthn

# ---------------------------------------------------------------------------
# Phase 5.3 — External secret providers
# ---------------------------------------------------------------------------
# Default cache TTL applied to new external-provider registrations (can be
# overridden per-provider via cacheTtlMs). Rotations in the upstream provider
# take up to this long to become visible in the runtime.
EXTERNAL_SECRETS_CACHE_TTL_MS=300000

# Optional deps to actually reach each provider:
#   AWS Secrets Manager:   pnpm --filter @ai-orchestrator/api add @aws-sdk/client-secrets-manager
#   HashiCorp Vault:       uses native fetch (no extra dep)
#   Google Secret Manager: pnpm --filter @ai-orchestrator/api add @google-cloud/secret-manager
#   Azure Key Vault:       pnpm --filter @ai-orchestrator/api add @azure/keyvault-secrets @azure/identity

# ---------------------------------------------------------------------------
# Phase 5.4 — Audit logging
# ---------------------------------------------------------------------------
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
AUDIT_LOG_PRUNE_INTERVAL_MS=3600000

# Phase 11.1 — signed run manifests and audit bundles.
# Ed25519 private key (base64 of a 32-byte seed) that signs run manifests and
# audit bundles. Treat it like SECRET_MASTER_KEY_BASE64. Leave empty and the
# API generates one on first use and stores it encrypted (only its key id is
# logged). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotate by setting a new value (or with Settings > Audit signing when the key
# is generated); old public keys stay listed so older bundles still verify.
# A cached manifest is pruned once it is older than AUDIT_LOG_RETENTION_DAYS
# and its execution history is gone; never while the history is kept.
AUDIT_SIGNING_KEY_BASE64=
# Largest audit bundle GET /api/executions/:id/bundle builds, in bytes; checked
# on the uncompressed files while assembling and on the final zip.
AUDIT_BUNDLE_MAX_BYTES=104857600

# ---------------------------------------------------------------------------
# Phase 15.1 — Golden runs and replay
# ---------------------------------------------------------------------------
# A golden run is a scrubbed copy of an execution kept apart from execution
# history, so EXECUTION_HISTORY_RETENTION_DAYS never removes it. Largest
# recording in bytes (input, node outputs and run facts; larger node outputs
# are cut and marked); the copied MCP cassette follows MCP_CASSETTE_MAX_BYTES.
REPLAY_RECORDING_MAX_BYTES=4194304
# Golden runs one workflow may keep. They are never pruned automatically, so
# saving past the limit is refused until some are deleted.
REPLAY_RECORDINGS_MAX_PER_WORKFLOW=500
# Total bytes one workflow's golden runs may use, copied MCP cassettes
# included (256 MiB). Saving past it is refused until some are deleted. A run
# can be saved as a golden run only once.
REPLAY_RECORDINGS_MAX_BYTES_PER_WORKFLOW=268435456
# Total bytes all golden runs in the deployment may use, cassettes included
# (1 GiB). Saving past it is refused until some are deleted.
REPLAY_RECORDINGS_MAX_TOTAL_BYTES=1073741824

# Phase 15.6 — production capture. A workflow can capture a sampled share of
# its production runs as candidate golden runs (masked with keyed surrogates)
# in its "Captured runs" inbox. Off for every workflow until a builder turns
# it on. REPLAY_CAPTURE_ENABLED=false stops all capture (kill switch).
REPLAY_CAPTURE_ENABLED=true
# Highest sampling rate any workflow may use, as a share between 0 and 1.
# The default, 1, means no ceiling.
REPLAY_CAPTURE_MAX_RATE=1
# Captured runs nobody promoted are deleted after this many days.
REPLAY_CAPTURE_RETENTION_DAYS=14
# Captured runs one workflow keeps waiting; the oldest goes when a new one arrives.
REPLAY_CAPTURES_MAX_PER_WORKFLOW=200
# Bytes one workflow's captured runs may use (200 MB); the oldest go first.
REPLAY_CAPTURES_MAX_BYTES_PER_WORKFLOW=209715200

# Phase 15.5 — largest golden-set file the import route accepts, in bytes
# (32 MiB). Callers are authenticated before the body is read.
GOLDEN_SET_IMPORT_MAX_BYTES=33554432

# ---------------------------------------------------------------------------
# Phase 11.2 — Approval gates
# ---------------------------------------------------------------------------
# How often the leader expires approval requests past their timeout (ms).
# Overdue requests are also expired once at startup.
APPROVAL_SWEEP_INTERVAL_MS=60000
# The web app's public URL, for the inbox link in approval notifications.
# Empty = notifications carry no link.
APP_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Phase 5.5 — Log streaming
# ---------------------------------------------------------------------------
# Streams audit + workflow events to external destinations (syslog, webhook, sentry).
# Destinations are configured at runtime from Settings → Log Streams (admin only).
LOG_STREAM_ENABLED=true
LOG_STREAM_FLUSH_INTERVAL_MS=2000
LOG_STREAM_BUFFER_SIZE=1000
LOG_STREAM_RETRY_MAX_ATTEMPTS=3
LOG_STREAM_EVENT_RETENTION_DAYS=14
LOG_STREAM_EVENT_PRUNE_INTERVAL_MS=3600000

# ---------------------------------------------------------------------------
# Phase 5.6 — Version control & environments
# ---------------------------------------------------------------------------
# Git sync uses the `git` CLI via child_process. Configure the remote from
# Settings → Source Control (admin only). Credentials may be embedded in the
# repo URL (e.g. https://<PAT>@github.com/owner/repo.git) — token-through-
# secret resolution is on the backlog.
GIT_SYNC_ENABLED=true
GIT_SYNC_WORKDIR=apps/api/data/git
GIT_BIN=git
GIT_COMMAND_TIMEOUT_MS=60000
# Workflow version snapshots kept per workflow (0 = keep forever).
WORKFLOW_VERSION_RETENTION=100

# ---------------------------------------------------------------------------
# Phase 5.7 — Observability & metrics
# ---------------------------------------------------------------------------
# Prometheus scrape endpoint: GET /metrics (public, text/plain v0.0.4).
# Health probe: GET /health (public).
# Admin dashboard: Settings → Observability; backing APIs under /api/observability.
METRICS_ENABLED=true
METRICS_PREFIX=ao
METRICS_INCLUDE_PROCESS=true
# SLO targets; drive the Observability UI chip and the ao_slo_* gauges.
METRICS_SLO_SUCCESS_TARGET=0.99
METRICS_SLO_P95_LATENCY_MS=30000

# OpenTelemetry span export. Leave disabled for in-memory only.
TRACING_ENABLED=false
# TRACING_ENDPOINT=http://otel-collector:4318/v1/traces
TRACING_SERVICE_NAME=ai-orchestrator

# Phase 8.1 — OpenTelemetry-grade observability.
# Standard OTEL_* env vars. If OTEL_EXPORTER_OTLP_ENDPOINT is set, traces
# (and metrics, when OTEL_METRICS_ENABLED=true) export over OTLP/HTTP-JSON.
# Per-signal endpoints (TRACES_/METRICS_) override the combined one if both
# are set. OTEL_EXPORTER_OTLP_HEADERS carries auth/tenancy headers as
# `key1=value1,key2=value2` (e.g. for Honeycomb, Grafana Cloud).
# OTEL_RESOURCE_ATTRIBUTES is merged into every span/metric resource.
# OTEL_HTTP_SERVER_SPANS=true emits an OTel SERVER span per HTTP request,
# adopting an upstream W3C `traceparent` header so cross-hop traces stay
# continuous through nginx/ALB/Cloudflare.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=YOUR_KEY,x-honeycomb-dataset=l2m
# OTEL_SERVICE_NAME=ai-orchestrator
# OTEL_SERVICE_VERSION=0.1.0
# OTEL_DEPLOYMENT_ENVIRONMENT=production
# OTEL_RESOURCE_ATTRIBUTES=team=platform,region=us-east-1
OTEL_METRICS_ENABLED=false
OTEL_METRICS_PUSH_INTERVAL_MS=60000
OTEL_HTTP_SERVER_SPANS=true

# Phase 8.2 — FinOps cost rollups.
# Aggregations live in usage_events (one row per execution, summed across all
# nodes that recorded _telemetry). The shipped pricing table covers OpenAI,
# Anthropic, and Gemini at list price; override per-tenant via this env var
# (same shape: { "providerId": { "model": { "inputUsdPer1M": ..., "outputUsdPer1M": ..., "cachedInputUsdPer1M": ... } } }).
# LLM_PRICING_OVERRIDES_JSON={"openai":{"gpt-4o":{"inputUsdPer1M":1.5,"outputUsdPer1M":6}}}
USAGE_EVENTS_RETENTION_DAYS=365

# Phase 9.5 / 15.2 — LLM judges for eval scorers.
# Programmatic scorers need no extra config. Judge scorers (faithfulness,
# answer_relevance, llm_judge) call an LLM for grading: EVAL_JUDGE_ENABLED=false
# turns every judge call off. A judge authenticates with its scorer's
# secretRef; one without a secretRef may use this deployment's provider
# environment keys (OPENAI_API_KEY and so on) only with
# EVAL_JUDGE_ALLOW_ENV_CREDENTIALS=true. Per-scorer providerId / model
# overrides take precedence over this default.
EVAL_JUDGE_ENABLED=false
EVAL_JUDGE_ALLOW_ENV_CREDENTIALS=false
EVAL_JUDGE_PROVIDER_ID=openai
EVAL_JUDGE_MODEL=gpt-4o-mini
EVAL_JUDGE_TEMPERATURE=0
EVAL_JUDGE_MAX_TOKENS=512
# Phase 15.2 — optional base URL for judge calls (an OpenAI-compatible or
# Ollama endpoint). Only the operator sets it; scorers never carry a URL.
# EVAL_JUDGE_BASE_URL=http://ollama:11434
# Phase 15.2 — replay jobs and eval runs run in the background. Cases running
# at once in one API process, the most cases one run may have, a replay
# job's default spend limit and every eval run's spend limit, in USD (model
# plus judge calls).
REPLAY_CONCURRENCY=2
REPLAY_JOB_MAX_CASES=200
REPLAY_JOB_DEFAULT_MAX_COST_USD=5
# Phase 15.3 — the most executions one replay job may run: golden-run cases x
# repeats, twice that with a baseline rerun. Requests over it are refused.
REPLAY_JOB_MAX_EXECUTIONS=500
EVAL_RUN_MAX_COST_USD=5
# A case output or run diff over this many bytes of JSON is stored truncated.
EVAL_RESULT_MAX_BYTES=262144
# Finished eval runs and replay jobs older than this are pruned (the newest
# run of every set is kept). 0 keeps them forever.
EVAL_RUN_RETENTION_DAYS=90
# Phase 15.6 — the most recent recordings one guard policy simulation may
# replay (requests default to 50). Simulations answer model calls from each
# recording's tape, so they never call a model; they are kept 30 days.
REPLAY_SIMULATION_MAX_CASES=200

# Phase 8.4 — Audit-log export to long-term sinks (SIEM / archive).
# Tamper-evidence (hash chain on audit_logs) is always on. Export
# destinations are CRUDed through Settings → Audit Log → Export
# Destinations or POST /api/audit-export/destinations.
# AUDIT_EXPORT_ENABLED=true turns on the periodic dispatcher; "Run now" works
# from the UI either way. AUDIT_EXPORT_FILE_ROOT sandboxes file-kind paths.
AUDIT_EXPORT_ENABLED=false
AUDIT_EXPORT_CHECK_INTERVAL_MS=60000
AUDIT_EXPORT_BATCH_SIZE=500
AUDIT_EXPORT_FILE_ROOT=apps/api/data

# MCP server registry
# The leader instance probes each registered server (initialize + tools/list)
# on this interval; 0 turns the background loop off ("Probe now" still works).
# Servers can override the interval or opt out of probing individually.
MCP_PROBE_INTERVAL_MS=300000
MCP_PROBE_TIMEOUT_MS=30000
MCP_PROBE_HISTORY_LIMIT=500

# MCP gateway (L2M as an MCP server at /mcp/<toolset>)
# Origins allowed to call the endpoint from a browser, comma-separated
# (https://tools.example.com). Requests without an Origin header, from WEB_ORIGIN
# and from MCP_GATEWAY_PUBLIC_URL are accepted; any other origin gets 403.
MCP_GATEWAY_ALLOWED_ORIGINS=
# Close a client session after this long without a request (stops the stdio
# servers it started). Minimum 10000.
MCP_GATEWAY_SESSION_IDLE_MS=1800000
# Open sessions across all clients; past it the least recently used idle
# session is closed, and with none idle a new session gets 503.
MCP_GATEWAY_MAX_SESSIONS=500
# Audit read-only registry tool calls: all | first_per_session | none.
# Write tools, workflow tools, failures and denials are always audited.
MCP_GATEWAY_AUDIT_READ_ONLY_CALLS=first_per_session
# Base URL clients use to reach this instance (shown in the UI's endpoint
# URLs and config snippets). Empty = the browser's origin.
MCP_GATEWAY_PUBLIC_URL=

# MCP catalog (deployment-local list of approved servers, no network fetch)
# Path to a JSON catalog file; empty = the built-in presets. The file is
# validated on start and whenever it changes; errors show on the MCP page.
# See samples/mcp-catalog.example.json.
MCP_CATALOG_FILE=
# merge = catalog entries plus the built-in presets; exclusive = catalog only.
MCP_CATALOG_MODE=merge
# true = stdio servers may only be registered or imported when their command
# matches an approved catalog entry with a pinned package version.
MCP_CATALOG_ENFORCE=false

# OAuth 2.1 for remote MCP servers (registry servers with auth type OAuth).
# The authorization server sends the admin's browser back to
# <base>/api/mcp/oauth/callback; register that URL with the authorization
# server when you pre-register a client. Empty = MCP_GATEWAY_PUBLIC_URL, else
# the first WEB_ORIGIN.
MCP_OAUTH_REDIRECT_BASE_URL=
# How long a started authorization stays valid (60000-3600000 ms).
MCP_OAUTH_STATE_TTL_MS=600000
# Refresh access tokens this long before they expire.
MCP_OAUTH_REFRESH_SKEW_MS=60000

# MCP elicitation and resources.
# Longest a server's question to the person running a workflow waits for an
# answer (10000-86400000 ms). The run's execution timeout keeps counting
# while it waits. Unattended runs (webhooks, schedules, queue, gateway)
# decline such questions at once.
MCP_ELICITATION_TIMEOUT_MS=600000
# Largest MCP resource a run or the playground reads (bytes).
MCP_RESOURCE_MAX_BYTES=5242880
# Phase 10.8 — size limits for MCP cassettes (recorded runs). A recording that
# reaches either limit stops adding calls and is marked truncated.
MCP_CASSETTE_MAX_BYTES=5242880
MCP_CASSETTE_MAX_CALLS=5000

# Phase 12.1 — Guard. When true (the default), agents in projects and
# workflows without a guard binding are checked with the built-in default
# guard profile (prompts, tool arguments, tool results and final answers).
# Project and workflow bindings and guard ports apply either way.
GUARD_AUTO_APPLY=true

# Phase 10.7 — MCP runtime safety.
# Sandbox for stdio servers that do not choose one: none (run on the API host)
# or container (needs an image on the server; see the MCP server registry docs).
MCP_SANDBOX_DEFAULT=none
# When true, no stdio server runs outside a container sandbox: registry
# servers must use one and inline stdio servers on nodes are refused.
MCP_SANDBOX_REQUIRED=false
# Comma-separated absolute host directories that sandbox mounts must resolve
# into, after following symlinks. Empty: sandboxes cannot mount host paths.
MCP_SANDBOX_ALLOWED_MOUNT_ROOTS=
# Container CLI: auto (docker, then podman), docker or podman.
MCP_SANDBOX_RUNTIME=auto

# ---------------------------------------------------------------------------
# Code nodes (JavaScript and Python)
# ---------------------------------------------------------------------------
# Master switch. When false, every code node fails with a clear error.
CODE_NODES_ENABLED=true
# Where code nodes run:
#   auto        use a container when docker/podman is installed and both images
#               are present locally; otherwise in process (a startup warning
#               is logged). This is the default.
#   container   insist on a container; code nodes fail if no runtime is found.
#   in_process  always run on the API host: JavaScript in a QuickJS WebAssembly
#               sandbox, Python as a host subprocess (NOT a sandbox, see below).
CODE_SANDBOX_MODE=auto
# Container CLI for code sandboxes: auto (docker, then podman), docker or podman.
CODE_SANDBOX_RUNTIME=auto
# Pinned images (tag or digest) with node / python3 on PATH, for container mode.
CODE_SANDBOX_JS_IMAGE=node:22.11.0-alpine3.20
CODE_SANDBOX_PYTHON_IMAGE=python:3.12.7-alpine3.20
# Resource ceilings for a code sandbox container. CODE_SANDBOX_MEMORY_MB is also
# the heap limit for one in-process JavaScript run.
CODE_SANDBOX_MEMORY_MB=256
CODE_SANDBOX_CPUS=1
CODE_SANDBOX_PIDS_LIMIT=128
# Time allowed for a code sandbox container to start, on top of the code's timeout (ms).
CODE_SANDBOX_STARTUP_MS=8000
# Python code nodes without a container: deny (default) makes them fail unless
# the container sandbox is used. allow runs them as host
# subprocesses with a minimal environment, python -I and a timeout. That is not
# a sandbox: the code can run any OS command, open network connections that
# bypass the outbound URL guard, read any file the API user can read (the
# SQLite database, .env) and, on Linux, the API's own environment through
# /proc/<pid>/environ -- which holds SECRET_MASTER_KEY_BASE64 when it is set
# there. Only allow it when every workflow author is trusted with the host.
CODE_SANDBOX_PYTHON_IN_PROCESS=deny
# Optional: run host Python as another uid/gid, so it cannot read the API's
# /proc entries or files only the API user can read. Needs the API to hold
# CAP_SETUID, CAP_SETGID and CAP_CHOWN (for example root inside a container).
# CODE_SANDBOX_PYTHON_GID defaults to the uid's number when only the uid is set.
CODE_SANDBOX_PYTHON_UID=
CODE_SANDBOX_PYTHON_GID=
# In-process JavaScript code nodes run on the API's event loop. Their timeout
# is clamped to CODE_SANDBOX_MAX_TIMEOUT_MS (100-300000 ms), and a per-item
# node may not run longer than four times that in all.
CODE_SANDBOX_MAX_TIMEOUT_MS=30000
# Largest result (results plus logs of all items) an in-process JavaScript
# code node may return (MB).
CODE_SANDBOX_MAX_RESULT_MB=32
# Time limit for a single {{ }} or Sort-node expression (ms).
EXPRESSION_TIMEOUT_MS=1000
# Heap limit for a single expression evaluation (MB).
EXPRESSION_MEMORY_MB=64
# Largest result one expression may return (MB, as JSON).
EXPRESSION_MAX_RESULT_MB=8
# Time budget for all the expressions of one template together (ms). Never
# less than EXPRESSION_TIMEOUT_MS.
EXPRESSION_TEMPLATE_BUDGET_MS=5000

# ---------------------------------------------------------------------------
# Outbound URL guard (HTTP Request, Web Browse, Chart data.url, HTML PDF)
# ---------------------------------------------------------------------------
# file:, data:, javascript: and other non-http(s) schemes are always refused,
# and cloud metadata (169.254.169.254, fd00:ec2::254, metadata.google.internal)
# and link-local addresses are always blocked. Private ranges and localhost are
# allowed by default.
# Set true to also block private ranges and localhost for those nodes.
OUTBOUND_DENY_PRIVATE=false
# Comma-separated hosts or CIDRs allowed through when OUTBOUND_DENY_PRIVATE is
# on, e.g. 10.0.0.0/8,*.internal,db.corp:5432. Never overrides the metadata or
# link-local block.
OUTBOUND_ALLOWLIST=

# ---------------------------------------------------------------------------
# Phase 7.1 — Deployment & HA
# ---------------------------------------------------------------------------
# WORKER_MODE:
#   all     — full API, scheduler/trigger/queue gated on leader (default)
#   api     — like `all` but without the eager initialization of scheduler/
#             trigger/queue (reserved for future split-plane topologies)
#   webhook — only serves /health, /metrics, /widget.js, and all /webhook/*,
#             /webhook-test/*, /api/webhooks/* routes; no background workers.
#   worker  — background-work only (reserved)
WORKER_MODE=all
# Leader election (only the leader runs schedules, triggers and timeouts).
# HA_ENABLED=false (the default): every instance is its own leader, with no
# lock and no lock connection. Right for one instance; with several on one
# Postgres database every instance runs every schedule and trigger.
# Running more than one instance on Postgres needs HA_ENABLED=true on each:
# instances with background workers (WORKER_MODE all/worker) then elect one
# leader with an advisory lock on a dedicated connection, checked every
# HA_RENEW_INTERVAL_MS. One instance holds the lock at a time; one that loses
# it stops within a renew interval, and after a lost host or network the
# server frees the lock within about three renew intervals. That connection
# must reach Postgres directly or through a session-mode pooler: PgBouncer
# transaction pooling breaks advisory locks. SQLite: HA_ENABLED=true turns on
# the lease row (HA_LEASE_TTL_MS).
HA_ENABLED=false
# Override the instance identifier shown in /api/ha/status. Defaults to
# hostname + random suffix.
# HA_INSTANCE_ID=
HA_LEASE_TTL_MS=30000
HA_RENEW_INTERVAL_MS=10000

# ---------------------------------------------------------------------------
# Phase 7.5 — Notifications
# ---------------------------------------------------------------------------
# When enabled, failed workflow executions can send alerts to Slack, Teams,
# and/or Email channels. Channels can also be configured at runtime via
# the Settings API (admin only).
NOTIFICATIONS_ENABLED=false

# Email (SMTP) notification channel
NOTIFICATION_SMTP_HOST=
NOTIFICATION_SMTP_PORT=587
NOTIFICATION_SMTP_SECURE=false
NOTIFICATION_SMTP_USER=
NOTIFICATION_SMTP_PASS=
NOTIFICATION_EMAIL_FROM=notifications@ai-orchestrator
NOTIFICATION_EMAIL_TO=

# Slack incoming webhook URL
NOTIFICATION_SLACK_WEBHOOK_URL=

# Microsoft Teams incoming webhook URL
NOTIFICATION_TEAMS_WEBHOOK_URL=
# Phase 11.2 — channels set above also send approval.requested and
# approval.timed_out. Channels stored in the database list their own events.
NOTIFICATIONS_APPROVAL_EVENTS=true

# ----------------------------------------------------------------------------
# Phase 6 — Community node SDK / marketplace
# ----------------------------------------------------------------------------
# Enable installation of l2m-nodes-* npm packages from the Settings UI.
# Off by default. Even when enabled, install/uninstall is admin-only and
# `npm install --ignore-scripts` is enforced. See
# /docs/extensions/community-nodes for the full threat model.
COMMUNITY_NODES_ENABLED=false

# Where the loader writes installed packages. node_modules/ lives below.
# The Helm chart's PVC mounts apps/api/data/, so packages survive restarts.
COMMUNITY_NODES_DIR=./data/plugins

# Comma-separated list of allowed package names. Each entry is either an
# exact name (l2m-nodes-cohere) or a glob suffix (l2m-nodes-corp-*). Empty
# = allow any l2m-nodes-* package. Recommended in production: pin specific
# allowed packages and review before enabling new ones.
COMMUNITY_NODES_ALLOWLIST=
